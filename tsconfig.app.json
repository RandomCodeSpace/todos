{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "types": [],
    "rootDir": "src",
    "outDir": ".build"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/sw.ts"]
}
